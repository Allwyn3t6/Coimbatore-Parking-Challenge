; Coimbatore Parking Challenge - Godot 4.4
config_version=5

[application]

config/name="Coimbatore Parking Challenge"
config/description="Park and race on real (de-identified) Coimbatore streets built from OpenStreetMap."
config/version="2.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.067, 0.086, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

AutoConfig="*res://scripts/auto_config.gd"
CityData="*res://scripts/city_data.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Rajdhani-Bold.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.086, 1)
